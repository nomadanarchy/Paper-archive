From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SeedSleuth <seedsleuth@localhost>
Date: Tue, 22 Sep 2026 00:00:00 +1000
Subject: [PATCH] Restore vanilla per-player RNG

Paper's shared entity Random makes a player's item-drop observations and
post-enchant XP-seed transition share state with every other entity.  Keep
the shared Random for non-player entities, but allow EntityHuman instances
to use the vanilla private Random required by enchantment cracking and RNG
manipulation.

The compatibility behaviour is enabled by default for this fork.  Set
settings.use-shared-random-for-players to true to restore stock Paper 1.12.2
behaviour.

diff --git a/src/main/java/com/destroystokyo/paper/PaperConfig.java b/src/main/java/com/destroystokyo/paper/PaperConfig.java
index 27203eea..6c629aec 100644
--- a/src/main/java/com/destroystokyo/paper/PaperConfig.java
+++ b/src/main/java/com/destroystokyo/paper/PaperConfig.java
@@ -334,4 +334,10 @@ public class PaperConfig {
             maxBookTotalSizeMultiplier = 0.98D;
         }
     }
+
+    public static boolean useSharedRandomForPlayers = false;
+    private static void useSharedRandomForPlayers() {
+        useSharedRandomForPlayers = getBoolean("settings.use-shared-random-for-players", false);
+        log("Using shared entity RNG for players: " + useSharedRandomForPlayers);
+    }
 }
diff --git a/src/main/java/net/minecraft/server/Entity.java b/src/main/java/net/minecraft/server/Entity.java
index 2d05e987..df32ee26 100644
--- a/src/main/java/net/minecraft/server/Entity.java
+++ b/src/main/java/net/minecraft/server/Entity.java
@@ -185,7 +185,10 @@ public abstract class Entity implements ICommandListener, KeyedObject { // Paper
         this.length = 1.8F;
         this.ax = 1;
         this.ay = 1.0F;
-        this.random = SHARED_RANDOM; // Paper
+        // SeedSleuth - vanilla-compatible player RNG. Item drops and the next XP seed must
+        // advance one private player stream for enchantment cracking/manipulation to work.
+        this.random = this instanceof EntityHuman && !com.destroystokyo.paper.PaperConfig.useSharedRandomForPlayers
+            ? new Random() : SHARED_RANDOM;
         this.fireTicks = -this.getMaxFireTicks();
         this.justCreated = true;
         this.uniqueID = MathHelper.a(this.random);
-- 
