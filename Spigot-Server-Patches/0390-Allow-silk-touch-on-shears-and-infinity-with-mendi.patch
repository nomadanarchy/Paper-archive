From 536da3af54c16982ce7acae08baea1c4fa40a41f Mon Sep 17 00:00:00 2001
From: bstar <76526844+bstar16@users.noreply.github.com>
Date: Tue, 29 Sep 2026 05:30:07 +1000
Subject: [PATCH] Allow silk touch on shears and infinity with mending on bows

---
 .../net/minecraft/server/Enchantment.java     |  4 +++
 .../server/EnchantmentInfiniteArrows.java     | 26 +++++++++++++++++++
 2 files changed, 30 insertions(+)
 create mode 100644 src/main/java/net/minecraft/server/EnchantmentInfiniteArrows.java

diff --git a/src/main/java/net/minecraft/server/Enchantment.java b/src/main/java/net/minecraft/server/Enchantment.java
index 0a51c1a84..8b164926c 100644
--- a/src/main/java/net/minecraft/server/Enchantment.java
+++ b/src/main/java/net/minecraft/server/Enchantment.java
@@ -107,6 +107,10 @@ public abstract class Enchantment {
     }
 
     public boolean canEnchant(ItemStack itemstack) {
+        // Paper - allow silk touch on shears
+        if (this == Enchantments.SILK_TOUCH && itemstack.getItem() == Items.SHEARS) {
+            return true;
+        }
         return this.itemTarget.canEnchant(itemstack.getItem());
     }
 
diff --git a/src/main/java/net/minecraft/server/EnchantmentInfiniteArrows.java b/src/main/java/net/minecraft/server/EnchantmentInfiniteArrows.java
new file mode 100644
index 000000000..2a31bc19f
--- /dev/null
+++ b/src/main/java/net/minecraft/server/EnchantmentInfiniteArrows.java
@@ -0,0 +1,26 @@
+package net.minecraft.server;
+
+public class EnchantmentInfiniteArrows extends Enchantment {
+
+    public EnchantmentInfiniteArrows(Enchantment.Rarity enchantment_rarity, EnumItemSlot... aenumitemslot) {
+        super(enchantment_rarity, EnchantmentSlotType.BOW, aenumitemslot);
+        this.c("arrowInfinite");
+    }
+
+    public int a(int i) {
+        return 20;
+    }
+
+    public int b(int i) {
+        return 50;
+    }
+
+    public int getMaxLevel() {
+        return 1;
+    }
+
+    public boolean a(Enchantment enchantment) {
+        // Paper - allow infinity and mending to coexist on bows
+        return super.a(enchantment);
+    }
+}
-- 
